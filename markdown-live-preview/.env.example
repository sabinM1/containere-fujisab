# ── Timezone ─────────────────────────────────────────────────────────
TZ=Europe/Bucharest

# ── Cloudflare Tunnel ────────────────────────────────────────────────
# Get this from Zero Trust → Networks → Tunnels → Docker
CLOUDFLARE_TUNNEL_TOKEN=CHANGEME

# ── Anubis ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ANUBIS_SECRET_KEY=CHANGEME

# The public domain served by Cloudflare Tunnel
PUBLIC_DOMAIN=md.example.com

# ── Anubis cookie settings ───────────────────────────────────────────
# Set to the parent domain you bought (e.g. example.com)
COOKIE_DOMAIN=example.com

GID=1000
