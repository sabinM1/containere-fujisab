# ─────────────────────────────────────────────────────────────
# MICROBIN
# ─────────────────────────────────────────────────────────────

MICROBIN_PUBLIC_PATH=https://bin.example.com
MICROBIN_ADMIN_USERNAME=CHANGEME
MICROBIN_ADMIN_PASSWORD=CHANGEME
MICROBIN_FOOTER_TEXT="Microbin. Report abuse/contact: CHANGEME"

# ─────────────────────────────────────────────────────────────
# ANUBIS
# Generate a new key with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
ANUBIS_SECRET_KEY=CHANGEME

# ─────────────────────────────────────────────────────────────
# CROWDSEC
# Get enrollment key from: https://app.crowdsec.net → Security Engines → Add Engine
# ─────────────────────────────────────────────────────────────
CROWDSEC_ENROLLMENT_KEY=CHANGEME

# Generate after first crowdsec start:
#   docker exec crowdsec-microbin cscli bouncers add cf-bouncer-microbin
# Then paste the key here and restart:
#   docker compose up -d crowdsec-cf-bouncer
CROWDSEC_BOUNCER_KEY=CHANGEME

# ─────────────────────────────────────────────────────────────
# CLOUDFLARE — shared across both stacks if same zone
# ─────────────────────────────────────────────────────────────
CF_API_TOKEN=CHANGEME
CF_ZONE_ID=CHANGEME
CF_ACCOUNT_ID=CHANGEME
CLOUDFLARE_TUNNEL_TOKEN=CHANGEME

# ─────────────────────────────────────────────────────────────
# SYSTEM
# ─────────────────────────────────────────────────────────────
GID=1000
