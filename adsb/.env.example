# ─────────────────────────────────────────────────────────────
# ANUBIS (adsb instance)
# Generate a new key with:
#   openssl rand -hex 32
# Must be exactly 64 hex characters, and kept stable across restarts
# so existing challenge-pass cookies stay valid.
# ─────────────────────────────────────────────────────────────
ANUBIS_ADSB_SECRET_KEY=CHANGEME

# ─────────────────────────────────────────────────────────────
# CLOUDFLARE TUNNEL (adsb instance — different tunnel than microbin)
# ─────────────────────────────────────────────────────────────
